*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
cloudflare/public/** text eol=lf
app/static/** text eol=lf

# WASM must remain an exact binary blob; the static text rules above must not
# normalize its bytes when the C2PA runtime is committed or archived.
app/static/*.wasm binary -eol
cloudflare/public/static/*.wasm binary -eol
