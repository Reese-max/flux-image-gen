# auto：有 NVIDIA_API_KEY 時用 NVIDIA，沒有時用 Demo
# demo：強制本機 Demo PNG
# nvidia：強制 NVIDIA FLUX API
IMAGE_PROVIDER=auto

# 到 https://build.nvidia.com 取得，格式通常是 nvapi-...
NVIDIA_API_KEY=

# 預設官方雲端 API，不需要改
NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai

# 產圖逾時秒數
REQUEST_TIMEOUT_SECONDS=120

# 後端硬性限流（FastAPI）。Cloudflare 部署另有 wrangler.toml 的 ratelimits binding。
# live：每 IP 每個 window 可真實出圖 N 次；demo：沒有金鑰或 demo 模式時分開計數。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=3600
GENERATE_RATE_LIMIT_PER_WINDOW=60
DEMO_GENERATE_RATE_LIMIT_PER_WINDOW=300

# Cloudflare Turnstile / anti-bot gate. Public deployments should set all three
# values; local demo can keep TURNSTILE_REQUIRED=false.
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=5

# 成本與生成次數 Dashboard（不記錄 prompt、圖片或金鑰）。
# FastAPI 會寫入 logs/usage-YYYY-MM-DD.jsonl；Worker 會輸出 usage_event 結構化 log。
USAGE_LOGGING_ENABLED=true
USAGE_LOG_DIR=logs
USAGE_ESTIMATED_COST_USD_PER_IMAGE=0.003
# Prompt／Vision 每次 provider attempt 的保守估值；未校準前維持 0，但仍記錄嘗試次數。
USAGE_ESTIMATED_PROMPT_COST_USD_PER_REQUEST=0
USAGE_ALERT_DAILY_GENERATIONS=1000

# Cloudflare R2 雲端圖庫站長清單。
# 本機 FastAPI 不會讀取 R2；部署到 Worker 後，請用：
#   npx wrangler secret put GALLERY_ADMIN_TOKEN
# 前端「用量」分頁的站長雲端圖庫會以 X-Gallery-Admin-Token 呼叫 GET /api/gallery。
# 此 token 不可放在前端 bundle、公開 repo 或 wrangler.toml [vars]。
GALLERY_ADMIN_TOKEN=

# FLUX.1-dev 可調參數
NVIDIA_DEV_STEPS=30
NVIDIA_DEV_CFG_SCALE=5
NVIDIA_DEV_SEED=0

# FLUX.1-schnell 建議維持 0 表示隨機 seed
NVIDIA_SCHNELL_SEED=0

# 快速（schnell）分層後端：NVIDIA 官方 flux.1-schnell 於 2026-07 故障（收請求、
# 通過驗證卻永不回應），改用 FLUX.2 klein 4B。預設本機後端直接走 NVIDIA
# flux.2-klein-4b（同一把 NVIDIA_API_KEY，約 4s 出圖，無需下列 Cloudflare 設定）。
# 若下列 CF_ACCOUNT_ID + CF_API_TOKEN 都填，schnell 會改走 Cloudflare Workers AI
# 的同名模型（與 Cloudflare 部署版一致，可選）。
# CF_ACCOUNT_ID：Cloudflare 儀表板網址中的帳號 ID
# CF_API_TOKEN：需具備 Workers AI 權限的 API token
CF_ACCOUNT_ID=
CF_API_TOKEN=
# 快速檔依尺寸分流：預設正方形走 FLUX.1 schnell（便宜、不帶自訂尺寸），
# 非正方形與自訂尺寸走 FLUX.2 klein（支援 width/height）。
WORKERS_AI_FAST_MODEL=@cf/black-forest-labs/flux-1-schnell
WORKERS_AI_SIZED_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# AI 改圖（POST /edit）：上傳 1-4 張自訂圖 + 文字指令，交給 Workers AI FLUX.2
# klein 做指令式編輯。同樣需上面的 CF_ACCOUNT_ID + CF_API_TOKEN；未設定時 /edit
# 回乾淨 503。（NVIDIA hosted kontext 只吃 3 張內建範例圖，無法上傳自訂圖，故走 Workers AI。）
WORKERS_AI_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Gemma：白話中文補全與中文轉英文提示詞
GEMINI_API_KEY=
GEMINI_PROMPT_MODEL=gemma-4-31b-it
GEMINI_COMPLETE_MODEL=gemma-4-26b-a4b-it
GEMINI_VISION_MODEL=gemini-2.5-flash
VISION_QA_ENABLED=false
# 生成後視覺 QA 的後端：nvidia（預設）與生圖共用同一把 NVIDIA_API_KEY，不必再備一組
# Gemini 金鑰；設 gemini 可切回 Gemini。指定的後端沒金鑰時會自動退到另一邊。
VISION_QA_PROVIDER=nvidia
# NVIDIA 的 VLM 走 OpenAI 相容端點，與生圖的 NVIDIA_BASE_URL（genai）不同。
NVIDIA_CHAT_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
