# auto：有 NVIDIA_API_KEY 時用 NVIDIA，沒有時用 Demo
# demo：強制本機 Demo PNG
# nvidia：強制 NVIDIA FLUX API
IMAGE_PROVIDER=auto

# 到 https://build.nvidia.com 取得，格式通常是 nvapi-...
NVIDIA_API_KEY=

# 預設官方雲端 API，不需要改
NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai

# 產圖逾時秒數
REQUEST_TIMEOUT_SECONDS=120

# FLUX.1-dev 可調參數
NVIDIA_DEV_STEPS=30
NVIDIA_DEV_CFG_SCALE=5
NVIDIA_DEV_SEED=0

# FLUX.1-schnell 建議維持 0 表示隨機 seed
NVIDIA_SCHNELL_SEED=0

# 快速（schnell）分層後端：NVIDIA 官方 flux.1-schnell 於 2026-07 故障（收請求、
# 通過驗證卻永不回應），改用 FLUX.2 klein 4B。預設本機後端直接走 NVIDIA
# flux.2-klein-4b（同一把 NVIDIA_API_KEY，約 4s 出圖，無需下列 Cloudflare 設定）。
# 若下列 CF_ACCOUNT_ID + CF_API_TOKEN 都填，schnell 會改走 Cloudflare Workers AI
# 的同名模型（與 Cloudflare 部署版一致，可選）。
# CF_ACCOUNT_ID：Cloudflare 儀表板網址中的帳號 ID
# CF_API_TOKEN：需具備 Workers AI 權限的 API token
CF_ACCOUNT_ID=
CF_API_TOKEN=
WORKERS_AI_FAST_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# AI 改圖（POST /edit）：上傳 1-4 張自訂圖 + 文字指令，交給 Workers AI FLUX.2
# klein 做指令式編輯。同樣需上面的 CF_ACCOUNT_ID + CF_API_TOKEN；未設定時 /edit
# 回乾淨 503。（NVIDIA hosted kontext 只吃 3 張內建範例圖，無法上傳自訂圖，故走 Workers AI。）
WORKERS_AI_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Gemma：白話中文補全與中文轉英文提示詞
GEMINI_API_KEY=
GEMINI_PROMPT_MODEL=gemma-4-31b-it
GEMINI_COMPLETE_MODEL=gemma-4-26b-a4b-it
