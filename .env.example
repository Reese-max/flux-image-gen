# auto：有 NVIDIA_API_KEY 時用 NVIDIA，沒有時用 Demo
# demo：強制本機 Demo PNG
# nvidia：強制 NVIDIA FLUX API
IMAGE_PROVIDER=auto

# 到 https://build.nvidia.com 取得，格式通常是 nvapi-...
NVIDIA_API_KEY=

# 預設官方雲端 API，不需要改
NVIDIA_BASE_URL=https://ai.api.nvidia.com/v1/genai

# 產圖逾時秒數
REQUEST_TIMEOUT_SECONDS=120

# FLUX.1-dev 可調參數
NVIDIA_DEV_STEPS=30
NVIDIA_DEV_CFG_SCALE=5
NVIDIA_DEV_SEED=0

# FLUX.1-schnell 建議維持 0 表示隨機 seed
NVIDIA_SCHNELL_SEED=0

# Gemma：白話中文補全與中文轉英文提示詞
GEMINI_API_KEY=
GEMINI_PROMPT_MODEL=gemma-4-31b-it
GEMINI_COMPLETE_MODEL=gemma-4-26b-a4b-it
