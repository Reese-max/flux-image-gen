# Cloudflare Workers static-assets headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Applied to responses served from ./public. Source of truth for the SPA lives in
# app/static; these deploy-only headers are Cloudflare-specific and live here.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://datasets-server.huggingface.co; font-src 'self'

# Fingerprint-free asset names, so cache modestly and revalidate in the background.
/static/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
